<!DOCTYPE html>
<html lang="en">
  <%-include("../includes/head.ejs")%>
  <body>
    <%-include("../includes/navigation.ejs")%>
    <main>
      <% if (errorMessage) { %>
        <div class="error-message"><%= errorMessage %></div>
      <% } %>
      <form class="login-form" action="/signup" method="POST" novalidate>
        <div class="form-control">
          <label for="email">Email</label>
          <input 
            class="<%= validationErrors.find((e) => e.path === 'email') ? 'invalid' : '' %>"
            type="email"
            name="email"
            id="email" value="<%= oldInput.email %>"
          />
        </div>
        <div class="form-control">
          <label for="password">Password</label>
          <input
            class="<%= validationErrors.find((e) => e.path === 'password') ? 'invalid' : '' %>"
            type="password"
            name="password" 
            id="password" value="<%= oldInput.password %>"
          />
        </div>
        <div class="form-control">
          <label for="confirmPassword">confirm Password</label>
          <input
            class="<%= validationErrors.find((e) => e.path === 'confirmPassword') ? 'invalid' : '' %>"
            type="password" 
            name="confirmPassword" 
            id="confirmPassword" value="<%= oldInput.confirmPassword %>"
          />
        </div>
        <input type="hidden" value="<%= csrfToken %>" name="_csrf" />
        <button class="login-btn" type="submit">SignUp</button>
      </form>
    </main>
    <%-include("../includes/end.ejs")%>
  </body>
</html>
