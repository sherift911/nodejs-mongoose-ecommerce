<Header class="main-header">
  <nav class="main-nav">
    <ul class="item-list">
      <li class="item">
        <a class="<%= path === '/' ? 'active' : '' %>" href="/">shop</a>
      </li>
      <li class="item">
        <a class="<%= path === '/products' ? 'active' : '' %>" href="/products"
          >products</a
        >
      </li>
      <% if (isAuthenticated) {%>
        <li class="item">
          <a class="<%= path === '/cart' ? 'active' : '' %>" href="/cart">cart</a>
        </li>
        <li class="item">
          <a class="<%= path === '/orders' ? 'active' : '' %>" href="/orders"
            >orders</a
          >
        </li>
        <li class="item">
          <a
            class="<%= path === '/admin/add-product' ? 'active' : '' %>"
            href="/admin/add-product"
            >Add product</a
          >
        </li>
        <li class="item">
          <a
            class="<%= path === '/admin/products' ? 'active' : '' %>"
            href="/admin/products"
            >Admin products</a
          >
        </li>
      <% } %>
    </ul>
    <ul class="login-ul">
        <% if(!isAuthenticated) { %>
          <li class="login-li">
            <a class="<%= path === '/login' ? 'active' : '' %>" href="/login"
              >Login</a
            >
          </li>
          <li class="login-li">
            <a class="<%= path === '/signup' ? 'active' : '' %>" href="/signup"
              >SignUp</a
            >
          </li>
        <% } else {%>
          <li class="logout_form">
            <form action="/logout" method="POST">
              <input type="hidden" value="<%= csrfToken %>" name="_csrf">
              <button type="submit">logout</button>
            </form>
          </li>
        <% } %>
      </ul>
    
  </nav>
</Header>
